  "runs": {
    "build-cosine-schedule": {
      "tests": [
        {
          "name": "test_start_and_end",
          "description": "The rate is top at step 0 and bottom at the last step.",
          "passed": false,
          "message": "cosine_lr(10000, 10000, 0.001, 0) gave 0.000770151, not bottom, 0. At the last step the wheel has turned half a turn, math.pi radians, where the cosine is -1."
        },
        {
          "name": "test_halfway",
          "description": "Halfway through, the rate is halfway between top and bottom.",
          "passed": false,
          "message": "cosine_lr(5000, 10000, 0.001, 0) gave 0.000938791, not 0.0005, halfway between top and bottom."
        },
        {
          "name": "test_never_rises",
          "description": "The rate never goes up from one step to the next.",
          "passed": true,
          "message": null
        },
        {
          "name": "test_cosine_shape",
          "description": "It stays above a straight line from top to bottom for the first half, and below it for the second.",
          "passed": false,
          "message": "At step 5,100 of 10,000 the rate is 0.000936372, not below the straight line's 0.00049: a cosine schedule falls fast in the middle."
        }
      ],
      "error": null,
      "output": ""
    },
    "build-polar": {
      "tests": [
        {
          "name": "test_distance",
          "description": "The distance is the square root of x squared plus y squared.",
          "passed": true,
          "message": null
        },
        {
          "name": "test_four_quarters",
          "description": "The angle is right in every quarter of the plane.",
          "passed": false,
          "message": "polar(-1, 1) gave the angle -0.785398, not 3 pi / 4, about 2.35619. The angle -0.785398 points the opposite way: check which quarter of the plane (-1, 1) is in."
        },
        {
          "name": "test_on_the_axes",
          "description": "Points on the axes have the angles 0, pi / 2, pi (or -pi, the same angle) and -pi / 2.",
          "passed": false,
          "message": "polar(0, 2) stopped with a ZeroDivisionError, a division by 0: (0, 2) is on the second axis, where x is 0, and its angle is pi / 2."
        },
        {
          "name": "test_round_trip",
          "description": "Turning (r, 0) through the angle gives back the point.",
          "passed": false,
          "message": "polar(-5, 12) gave (13, -1.17601), and turning (13, 0) through -1.17601 gives (5, -12), not (-5, 12)."
        }
      ],
      "error": null,
      "output": ""
    },
    "build-rotate-about": {
      "tests": [
        {
          "name": "test_example",
          "description": "A quarter turn of (2, 1) about (1, 1) gives (1, 2).",
          "passed": false,
          "message": "rotate_about(2, 1, 1, 1, math.pi / 2) gave (0, 1), not (1, 2)."
        },
        {
          "name": "test_centre_stays",
          "description": "The centre itself does not move.",
          "passed": false,
          "message": "Turning the centre (1, 1) about itself gave (0, 0): the centre should stay where it is."
        },
        {
          "name": "test_keeps_distance",
          "description": "Every point keeps its distance from the centre.",
          "passed": false,
          "message": "rotate_about(2, 1, 1, 1, 0.5) gave (0.877583, 0.479426), 0.534775 from the centre, but (2, 1) is 1 from it."
        },
        {
          "name": "test_quarter_and_half_turns",
          "description": "Quarter and half turns about a centre land where they should.",
          "passed": false,
          "message": "rotate_about(5, -1, -2, 3, math.pi / 2) gave (4, 7), not (2, 10)."
        },
        {
          "name": "test_turns_by_the_angle",
          "description": "Seen from the centre, the point turns anticlockwise through exactly the angle.",
          "passed": false,
          "message": "Seen from the centre (-2, 3), rotate_about(5, -1, -2, 3, 0.7) turned the point through 0.36433 radians, not 0.7."
        }
      ],
      "error": null,
      "output": ""
    },
    "debug-rotate": {
      "tests": [
        {
          "name": "test_quarter_turn",
          "description": "A quarter turn takes (1, 0) to (0, 1).",
          "passed": false,
          "message": "rotate(1, 0, math.pi / 2) gave (0, 0), not (0, 1)."
        },
        {
          "name": "test_three_one",
          "description": "A quarter turn takes (3, 1) to (-1, 3).",
          "passed": false,
          "message": "rotate(3, 1, math.pi / 2) gave (-1, -1), not (-1, 3)."
        },
        {
          "name": "test_keeps_distance",
          "description": "Turning keeps a point's distance from the origin.",
          "passed": false,
          "message": "rotate(1, 0, 0.3) gave (0.955336, 0.282321), 0.996179 from the origin, but (1, 0) is 1 from it."
        },
        {
          "name": "test_two_turns",
          "description": "Turning by one angle and then by another is turning by their sum.",
          "passed": false,
          "message": "Turning (2, 1) by 0.4 and then by 0.9 gave (-0.261612, 0.719263), but turning it by 1.3 at once gave (-0.428561, -0.145444)."
        }
      ],
      "error": null,
      "output": ""
    }
  }
